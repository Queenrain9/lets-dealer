; Engine configuration file.
; LET'S DEALER core gameplay prototype.

config_version=5

[application]

config/name="LET'S DEALER"
config/description="Mobile dealer-action game core gameplay prototype"
run/main_scene="res://scenes/table_test.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[debug]

settings/stdout/print_fps=false
