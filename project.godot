; Lucky Dealer - first playable card-dealing feature.
config_version=5

[application]
config/name="Lucky Dealer - 카드 배분 훈련"
run/main_scene="res://scenes/table.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]
file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.039, 0.052, 0.058, 1)
